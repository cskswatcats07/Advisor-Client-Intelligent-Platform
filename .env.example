# Public site URL (used for invite links, OG tags, PDF absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin dashboard password (plain text for local, or bcrypt hash)
ADMIN_PASSWORD=wedding-admin
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Optional Supabase persistence (falls back to local data/wedding.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
